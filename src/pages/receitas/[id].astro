---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map(recipe => ({
    params: { id: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const { title, description, category, image, prepTime, cookTime, servings } = recipe.data;
---

<Layout title={title}>
  <article style="max-width: 800px; margin: 0 auto; background-color: var(--color-surface); border-radius: 16px; overflow: hidden; box-shadow: var(--shadow-light);">
    
    {image && (
      <div style="width: 100%; height: 400px; overflow: hidden;">
        <img src={image} alt={title} style="width: 100%; height: 100%; object-fit: cover;" />
      </div>
    )}
    
    <div style="padding: 40px;">
      <div style="margin-bottom: 24px;">
        <CategoryBadge category={category} />
      </div>
      
      <h1 style="margin-bottom: 16px;">{title}</h1>
      <p style="font-size: 18px; color: var(--color-text-muted); margin-bottom: 32px;">{description}</p>
      
      <div style="display: flex; flex-wrap: wrap; gap: 24px; padding: 24px; background-color: var(--color-background); border-radius: 12px; margin-bottom: 40px;">
        {prepTime && (
          <div>
            <div style="font-size: 14px; color: var(--color-text-muted); font-weight: 600; margin-bottom: 4px;">Preparo</div>
            <div style="font-size: 16px; font-weight: 700;">{prepTime}</div>
          </div>
        )}
        {cookTime && (
          <div>
            <div style="font-size: 14px; color: var(--color-text-muted); font-weight: 600; margin-bottom: 4px;">Cozimento</div>
            <div style="font-size: 16px; font-weight: 700;">{cookTime}</div>
          </div>
        )}
        {servings && (
          <div>
            <div style="font-size: 14px; color: var(--color-text-muted); font-weight: 600; margin-bottom: 4px;">Rendimento</div>
            <div style="font-size: 16px; font-weight: 700;">{servings}</div>
          </div>
        )}
      </div>

      <div class="recipe-content">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .recipe-content h2 {
    color: var(--color-primary);
    margin-top: 32px;
    margin-bottom: 16px;
    font-size: 24px;
  }
  
  .recipe-content ul {
    list-style-type: none;
    padding-left: 0;
    margin-bottom: 24px;
  }
  
  .recipe-content ul li {
    position: relative;
    padding-left: 24px;
    margin-bottom: 12px;
    font-size: 16px;
  }
  
  .recipe-content ul li::before {
    content: "•";
    color: var(--color-primary);
    font-size: 20px;
    position: absolute;
    left: 0;
    top: -2px;
  }
  
  .recipe-content ol {
    padding-left: 20px;
    margin-bottom: 24px;
  }
  
  .recipe-content ol li {
    margin-bottom: 16px;
    padding-left: 8px;
    font-size: 16px;
  }
  
  .recipe-content ol li::marker {
    color: var(--color-primary);
    font-weight: 700;
  }
</style>

---
import type { CollectionEntry } from 'astro:content';
import CategoryBadge from './CategoryBadge.astro';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { title, description, category, tags = [], image, prepTime } = recipe.data;
---

<a href={`/receitas/${recipe.id}`} class="card recipe-card" data-title={title.toLowerCase()} data-description={description.toLowerCase()} data-category={category.toLowerCase()} data-tags={tags.join(',').toLowerCase()} style="display: flex; flex-direction: column; text-decoration: none; color: inherit; height: 100%;">
  <div style="position: relative; width: 100%; padding-top: 60%; background-color: #EEE;">
    {image ? (
      <img src={image} alt={title} style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
    ) : (
      <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--color-text-muted);">
        Sem imagem
      </div>
    )}
    <div style="position: absolute; top: 16px; right: 16px;">
      <CategoryBadge category={category} />
    </div>
  </div>
  
  <div style="padding: 24px; flex-grow: 1; display: flex; flex-direction: column;">
    <h3 style="font-size: 20px; line-height: 1.3; margin-bottom: 8px;">{title}</h3>
    <p style="color: var(--color-text-muted); font-size: 14px; margin-bottom: 16px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; flex-grow: 1;">
      {description}
    </p>

    {tags && tags.length > 0 && (
      <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px;">
        {tags.map(tag => (
          <span style="background-color: #F3F4F6; color: var(--color-text-muted); font-size: 12px; padding: 4px 8px; border-radius: 4px; font-weight: 500;">
            #{tag}
          </span>
        ))}
      </div>
    )}
    
    {prepTime && (
      <div style="display: flex; align-items: center; gap: 6px; color: var(--color-text-muted); font-size: 14px; font-weight: 600;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        {prepTime}
      </div>
    )}
  </div>
</a>
